# Celesto Sandbox Configuration
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
CELESTO_TEMPLATE_ID=scratch

# LLM Provider Configuration (OpenAI-compatible)
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name

# PostgreSQL Run Ledger Configuration
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# HTTP Control Plane Configuration
API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/commands.jsonl
